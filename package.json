{
  "name": "ifaqa-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build && opennextjs-cloudflare build --skipNextBuild",
    "build:next": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "preview": "next build && opennextjs-cloudflare build --skipNextBuild && opennextjs-cloudflare preview",
    "deploy": "next build && opennextjs-cloudflare build --skipNextBuild && wrangler deploy"
  },
  "dependencies": {
    "next": "^15.5.29",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "firebase": "^10.14.0",
    "lucide-react": "^0.453.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.19",
    "typescript": "^5.4.0",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "autoprefixer": "^10.4.20",
    "wrangler": "^4.168.0"
  }
}
